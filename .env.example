# ==============================================================================
# StockFlow Environment Configuration Template (.env.example)
# ==============================================================================
# Copy this file to .env and configure the values for your deployment environment.
# DO NOT commit real secrets or production .env files to GitHub.
# ==============================================================================

# Application Port
PORT=8080

# Active Spring Profiles: 'prod' for production, 'default' for local dev
SPRING_PROFILES_ACTIVE=prod

# ==============================================================================
# Database Configuration (PostgreSQL 16)
# ==============================================================================
DB_URL=jdbc:postgresql://localhost:5432/stockflow
DB_USERNAME=stockflow_user
DB_PASSWORD=change_this_to_a_strong_password_in_production

# Hikari Connection Pool Settings
HIKARI_MAX_POOL_SIZE=20
HIKARI_MIN_IDLE=5

# ==============================================================================
# Security & Cryptography
# ==============================================================================
# 256-bit or 512-bit Base64 / Hex encoded secret for JWT token signing.
# Generate a secure 256-bit key using: openssl rand -hex 32
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970
JWT_ACCESS_EXPIRATION_MS=900000        # 15 minutes
JWT_REFRESH_EXPIRATION_MS=604800000    # 7 days

# Payment Gateway Webhook HMAC Secret (used for verifying incoming webhook signatures)
PAYMENT_WEBHOOK_SECRET=whsec_replace_with_production_hmac_secret_in_prod

# CORS Allowed Origin Patterns (comma-separated or regex pattern)
# Example: https://app.stockflow.com,https://seller.stockflow.com
CORS_ALLOWED_ORIGINS=*

# ==============================================================================
# Background Worker Schedules & Parameters
# ==============================================================================
# Reservation Expiry Worker (runs every 30 seconds)
RESERVATION_WORKER_CRON=*/30 * * * * *
RESERVATION_TTL_MINUTES=15

# Transactional Outbox Poller Worker (runs every 10 seconds)
OUTBOX_WORKER_CRON=*/10 * * * * *
OUTBOX_BATCH_SIZE=50
